{
  "category": "🔄 Recipe",
  "description": "Takes multiline numbers from selection, converts each to words, and outputs row-by-row",
  "id": "recipe_numbers_to_words",
  "input_source": "selection",
  "name": "Numbers to Words (Row by Row)",
  "sink": "clipboard",
  "steps": [
    {
      "bindings": {
        "text": "input.text"
      },
      "id": "step_1",
      "settings": {
        "delimiter": "\\n"
      },
      "tool_id": "primitive_split",
      "tool_version": 1
    },
    {
      "bindings": {
        "items": "step_1.items"
      },
      "id": "step_2",
      "is_container": 1,
      "loop_return_step": "step_2_3",
      "sub_steps": [
        {
          "bindings": {
            "text": "loop.item"
          },
          "id": "step_2_1",
          "settings": {},
          "tool_id": "parse_number",
          "tool_version": 1
        },
        {
          "bindings": {
            "number": "step_2_1.number"
          },
          "id": "step_2_2",
          "settings": {},
          "tool_id": "number_to_words",
          "tool_version": 1
        },
        {
          "bindings": {},
          "id": "step_2_3",
          "settings": {
            "template": "{loop.item} : {step_2_2.words}"
          },
          "tool_id": "primitive_template_combine",
          "tool_version": 1
        }
      ]
    },
    {
      "bindings": {
        "items": "step_2.items"
      },
      "id": "step_3",
      "settings": {
        "delimiter": "\\n"
      },
      "tool_id": "primitive_join",
      "tool_version": 1
    }
  ],
  "version": 1
}