{
  "category": "🔄 Recipe",
  "description": "Calculates standard forward GST on base amount(s) and converts total amount to words",
  "id": "recipe_forward_gst_words",
  "input_source": "selection",
  "name": "Normal Forward GST & Words",
  "sink": "clipboard",
  "steps": [
    {
      "bindings": {
        "text": "input.text"
      },
      "id": "step_1",
      "settings": {
        "delimiter": "\\n"
      },
      "tool_id": "primitive_split",
      "tool_version": 1
    },
    {
      "bindings": {
        "items": "step_1.items"
      },
      "id": "step_2",
      "settings": {},
      "tool_id": "loop_start",
      "tool_version": 1
    },
    {
      "bindings": {
        "text": "loop.item"
      },
      "id": "step_3",
      "settings": {},
      "tool_id": "parse_number",
      "tool_version": 1
    },
    {
      "bindings": {
        "amount": "step_3.number"
      },
      "id": "step_4",
      "settings": {
        "rate": 18
      },
      "tool_id": "normal_gst",
      "tool_version": 1
    },
    {
      "bindings": {
        "number": "step_4.total"
      },
      "id": "step_5",
      "settings": {},
      "tool_id": "number_to_words",
      "tool_version": 1
    },
    {
      "bindings": {},
      "id": "step_6",
      "settings": {
        "template": "{step_4.summary}\\nAmount in Words: {step_5.words}"
      },
      "tool_id": "primitive_template_combine",
      "tool_version": 1
    },
    {
      "bindings": {
        "collect": "step_6.text"
      },
      "id": "step_7",
      "settings": {},
      "tool_id": "loop_end",
      "tool_version": 1
    },
    {
      "bindings": {
        "items": "step_7.items"
      },
      "id": "step_8",
      "settings": {
        "delimiter": "\\n\\n"
      },
      "tool_id": "primitive_join",
      "tool_version": 1
    }
  ],
  "version": 1
}